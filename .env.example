# Frontend (exposed to browser) — safe public keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Netlify Functions ONLY (server-side, NEVER exposed to browser).
# Set these in Netlify dashboard: Site settings > Environment variables.
GROQ_API_KEY=
GEMINI_API_KEY=
CAREERJET_AFFID=
RESEND_API_KEY=

# SMTP para envio automático de candidaturas (ex: Gmail/Cloudflare Email Routing)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=suporte@mosalo.eu.cc
SMTP_PASS=

# Proteção opcional do endpoint de webhook
AUTO_APPLY_WEBHOOK_SECRET=
